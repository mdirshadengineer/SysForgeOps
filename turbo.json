{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "API_BASE_URL", "CLI_MODE", "DATABASE_URL"],
  "ui": "stream",
  "tasks": {
    "clean": { "cache": false },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
