{
  "name": "sysforgeops-monorepo",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for SysForgeOps CLI, Server, Core, UI, and shared packages.",
  "homepage": "https://github.com/mdirshadengineer/SysForgeOps",
  "bugs": "https://github.com/mdirshadengineer/SysForgeOps/issues",
  "license": "MIT",
  "author": {
    "name": "Md Irshad",
    "email": "mdirshadengineer+github@gmail.com",
    "url": "https://mdirshad.vercel.app"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production ./compiled/bin/sysforgeops.js start -p 3000",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "lodash": "^4.17.21",
    "picocolors": "^1.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.7.2",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsdoc": "^48.3.2",
    "eslint-plugin-json": "^4.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "fs-extra": "^11.3.2",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
